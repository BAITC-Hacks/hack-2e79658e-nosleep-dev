# apps/api
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
# Leave empty for embedded scoring data and automatic event data discovery.
DATA_DIR=

# LLM — OpenAI-compatible client. Defaults to NVIDIA NIM's free tier.
# Get a free key at https://build.nvidia.com (NVIDIA NIM) or use an OpenAI key + base URL.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=25

# When true, /explain and /compare always return cached, clearly-labeled
# responses and never call the LLM. Works with LLM_API_KEY unset.
DEMO_MODE=false

# apps/web
# Leave empty to use the Next.js /api/v1 proxy on the current origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_USE_MOCKS=false
