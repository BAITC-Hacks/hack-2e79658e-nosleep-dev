# apps/api
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
# Leave empty for embedded scoring data and automatic event data discovery.
DATA_DIR=

# LLM — OpenAI API. Create a secret key at https://platform.openai.com/api-keys.
# Keep this key on the backend; never add NEXT_PUBLIC_ to its name.
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=25

# When true, /explain and /compare always return cached, clearly-labeled
# responses and never call the LLM. Works with OPENAI_API_KEY unset.
DEMO_MODE=false

# apps/web
# Leave empty to use the Next.js /api/v1 proxy on the current origin.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_USE_MOCKS=false
